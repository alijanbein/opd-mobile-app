# The FastAPI backend's base URL. localhost/127.0.0.1 will NOT work when
# running on a physical device or a separate emulator/simulator network
# namespace — use your dev machine's LAN IP instead (e.g. run `ipconfig`
# on Windows / `ifconfig` on Mac/Linux and find the IPv4 address).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.65:8000

# The web app's dev server (Orthopedic OPD AI/frontend, `npm run dev`,
# Vite default port 5173). Used only to embed its existing PROM
# questionnaire fill-in page (/prom/:token) in a WebView — see
# app/prom-fill.tsx. Same localhost-won't-work-on-device caveat as above.
EXPO_PUBLIC_WEB_APP_BASE_URL=http://192.168.1.65:5173
