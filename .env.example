# Both of these are OPTIONAL overrides. By default api/host.ts auto-detects your dev
# machine's current LAN IP from the running Metro dev server (Constants.expoConfig.hostUri)
# and builds these URLs itself — see README.md "Running it". You only need to set these if:
#   - the backend/web app run on a different machine than the one running `expo start`, or
#   - you're building a production/EAS binary, where there's no dev server to introspect.
# EXPO_PUBLIC_API_BASE_URL=http://172.20.10.2:8000

# EXPO_PUBLIC_WEB_APP_BASE_URL=http://172.20.10.2:5173
